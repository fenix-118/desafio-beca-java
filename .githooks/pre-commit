#!/usr/bin/env bash
# Bloqueia commits com segredos (tarefa 8.7). Ativar uma vez por clone:
#   git config core.hooksPath .githooks
# Falso positivo confirmado: git commit --no-verify
set -uo pipefail

problemas=()

# 1. Arquivos que nunca devem ir para o Git.
while IFS= read -r arquivo; do
  [ -z "$arquivo" ] && continue
  nome="$(basename "$arquivo")"
  case "$nome" in
    .env.example) ;;
    .env|*.env|.env.*|*.pem|*.key|*.p12|*.jks)
      problemas+=("arquivo proibido: $arquivo") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2. Linhas novas com senha, token ou chave em valor literal.
arquivo=""
while IFS= read -r linha; do
  if [[ "$linha" == "+++ b/"* ]]; then
    arquivo="${linha#+++ b/}"
    continue
  fi
  [[ "$linha" == "+"* ]] || continue
  conteudo="${linha:1}"

  # Testes e CSVs de exemplo usam senhas fictícias de propósito.
  case "$arquivo" in
    */src/test/*|samples/*|.githooks/*) continue ;;
  esac

  if grep -qE -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' <<< "$conteudo"; then
    problemas+=("$arquivo: chave privada")
  fi
  if grep -qiE 'https?://[a-z0-9]{16,}\.mockapi\.io' <<< "$conteudo"; then
    problemas+=("$arquivo: URL real da API Mock (deixe só no .env)")
  fi

  case "$arquivo" in
    *.java)
      # Em Java, só string literal sem espaço atribuída a algo com nome de senha/token.
      if grep -qiE '(password|passwd|secret|token|apikey|api_key)[a-z_]*[[:space:]]*=[[:space:]]*"[^" ]{4,}"' <<< "$conteudo"; then
        problemas+=("$arquivo: $conteudo")
      fi ;;
    *.yml|*.yaml|*.properties|*.env*|*.json|*.sh|*.xml|docker-compose*)
      # Variável de segredo com valor padrão literal ("\${SENHA:minhaSenha}", "\${TOKEN:-abc}") é segredo no Git.
      if grep -qiE '\$\{[a-z0-9_]*(password|passwd|senha|secret|token|api_?key)[a-z0-9_]*:-?[^}?$:]' <<< "$conteudo" \
          && ! grep -qiE ':-?(troque_aqui|changeme)\}' <<< "$conteudo"; then
        problemas+=("$arquivo: $conteudo")
        continue
      fi
      # Só o placeholder SEM valor padrão vira ${ENV} antes da checagem: \${VAR}, \${VAR:} e \${VAR:?mensagem},
      # inclusive aninhado (\${A:\${B:}}). Qualquer outro valor continua sendo conferido.
      for _ in 1 2 3; do
        conteudo="$(sed -E 's/\$\{[A-Za-z0-9_]+(:-?(\$\{ENV\})?|:\?[^}]*)?\}/${ENV}/g' <<< "$conteudo")"
      done
      valor="$(grep -oiE '(password|passwd|senha|secret|token|api[_-]?key)[a-z_]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[^"'"'"'[:space:]]+' <<< "$conteudo" \
        | head -1 | sed -E 's/^[^:=]*[:=][[:space:]]*["'"'"']?//')"
      if [ -n "$valor" ]; then
        # Aceita só uma variável inteira (${ENV}, $VAR, ${VAR}) ou um valor de exemplo; "${X}abc" não passa.
        if ! [[ $valor =~ ^\$\{?[A-Za-z_][A-Za-z0-9_]*\}?$ || $valor == troque_aqui || $valor == changeme || $valor == '<'* ]]; then
          problemas+=("$arquivo: $conteudo")
        fi
      fi ;;
  esac
done < <(git diff --cached -U0 --no-color)

if [ ${#problemas[@]} -gt 0 ]; then
  echo "pre-commit: possível segredo no commit. Nada foi gravado."
  printf '  - %s\n' "${problemas[@]}"
  echo "Use variável de ambiente (\${...}) e deixe o valor no .env."
  echo "Se for falso positivo confirmado: git commit --no-verify"
  exit 1
fi
exit 0
